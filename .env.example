# Copy to .env and adjust. All values are optional.
SENTINEL_SECRET_KEY=change-this-to-a-long-random-string
SENTINEL_TOKEN_TTL=28800
# Local LLM via Ollama (leave empty to use the built-in grounded answer engine)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT=90
# Embeddings: lsa (built-in, offline) | sentence-transformers
EMBEDDING_BACKEND=lsa
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SEED_DEMO_DATA=true
